# ---------------------------------------------------------------------------
# Public site details (safe to expose; inlined into the client bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Studio
NEXT_PUBLIC_SITE_LEGAL_NAME=Studio
NEXT_PUBLIC_LOCATION=Chennai, India
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourstudio.com
# International format, digits only (e.g. 919876543210). Leave empty to hide the WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Social profiles — empty values are not rendered.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ---------------------------------------------------------------------------
# Contact form delivery (server-only). Configure ONE provider.
# ---------------------------------------------------------------------------
# Option A — Resend (free tier). Without a verified domain, Resend can only send
# to the email address of the Resend account, so set CONTACT_TO_EMAIL to that.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a verified sender, e.g. "Studio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=

# Option B — Web3Forms (free tier, no domain needed). Create a key at web3forms.com
# with the inbox that should receive inquiries.
WEB3FORMS_ACCESS_KEY=
